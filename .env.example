# SUBZWARI GLOBAL NETWORK — environment variables
# Copy to .env and fill in real values. Never commit .env.

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/subzwari?schema=public"

# --- Auth (NextAuth / Auth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Optional Google OAuth (off by default; both must be set to enable)
AUTH_GOOGLE_ENABLED="false"
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# --- Email OTP / password reset ---
OTP_EXPIRY_MINUTES="10"

# --- Email provider (provider-agnostic; pick one implementation in lib/email) ---
EMAIL_PROVIDER="resend" # resend | ses | smtp
EMAIL_FROM_ADDRESS="SUBZWARI Global Network <no-reply@subzwari.example>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# --- File storage (S3-compatible / Cloudflare R2) ---
STORAGE_PROVIDER="r2" # r2 | s3
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""
NEXT_PUBLIC_MEDIA_HOSTNAME="media.subzwari.example"

# --- Rate limiting (optional in dev; required in production) ---
RATE_LIMIT_PROVIDER="memory" # memory | upstash
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Admin bootstrap (used only by prisma/seed.ts to create the first Super Admin) ---
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""
